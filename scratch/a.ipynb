 "cells": [
  {
   "metadata": {},
   "cell_type": "raw",
   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Vectorized Dense DFA (formerly Aho-Corasick)\\n\",\n",
    "    \"\\n\",\n",
    "    \"This notebook demonstrates how to compile a set of string patterns into a **Dense Deterministic Finite Automaton (DFA)**.\\n\",\n",
    "    \"\\n\",\n",
    "    \"Unlike a standard Aho-Corasick implementation which uses `while` loops to follow failure links dynamically, this implementation pre-calculates the destination state for every possible byte (0-255) at every node. \\n\",\n",
    "    \"\\n\",\n",
    "    \"This results in an $O(1)$ lookup structure compatible with vector engines like PyTorch and ONNX.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import torch\\n\",\n",
    "    \"import torch.nn as nn\\n\",\n",
    "    \"from collections import deque\\n\",\n",
    "    \"import numpy as np\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 1. The Builder\\n\",\n",
    "    \"\\n\",\n",
    "    \"The `DFABuilder` takes a list of patterns and constructs the transition matrix.\\n\",\n",
    "    \"\\n\",\n",
    "    \"- **Input:** List of strings.\\n\",\n",
    "    \"- **Output:** \\n\",\n",
    "    \"    - `Transition Table`: A flattened array where `index = current_state * 256 + byte`.\\n\",\n",
    "    \"    - `Match Table`: A binary matrix indicating which patterns match at which state.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"class DFABuilder:\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Builds a dense DFA table from a list of patterns.\\n\",\n",
    "    \"    Pre-computes state transitions for all 256 byte values.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    def __init__(self, patterns):\\n\",\n",
    "    \"        self.patterns = patterns\\n\",\n",
    "    \"        self.num_patterns = len(patterns)\\n\",\n",
    "    \"        # State 0 is root\\n\",\n",
    "    \"        self.trie = [{'next': {}, 'fail': 0, 'output': []}]\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # 1. Build Standard Trie\\n\",\n",
    "    \"        for i, pattern in enumerate(patterns):\\n\",\n",
    "    \"            node = 0\\n\",\n",
    "    \"            if isinstance(pattern, str):\\n\",\n",
    "    \"                pattern = pattern.encode('utf-8')\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            for char in pattern:\\n\",\n",
    "    \"                if char not in self.trie[node]['next']:\\n\",\n",
    "    \"                    self.trie[node]['next'][char] = len(self.trie)\\n\",\n",
    "    \"                    self.trie.append({'next': {}, 'fail': 0, 'output': []})\\n\",\n",
    "    \"                node = self.trie[node]['next'][char]\\n\",\n",
    "    \"            self.trie[node]['output'].append(i)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # 2. Build Failure Links (Aho-Corasick BFS)\\n\",\n",
    "    \"        queue = deque()\\n\",\n",
    "    \"        for char, next_node in self.trie[0]['next'].items():\\n\",\n",
    "    \"            queue.append(next_node)\\n\",\n",
    "    \"            \\n\",\n",
    "    \"        while queue:\\n\",\n",
    "    \"            r = queue.popleft()\\n\",\n",
    "    \"            for char, u in self.trie[r]['next'].items():\\n\",\n",
    "    \"                queue.append(u)\\n\",\n",
    "    \"                f = self.trie[r]['fail']\\n\",\n",
    "    \"                while char not in self.trie[f]['next'] and f != 0:\\n\",\n",
    "    \"                    f = self.trie[f]['fail']\\n\",\n",
    "    \"                self.trie[u]['fail'] = self.trie[f]['next'].get(char, 0)\\n\",\n",
    "    \"                # Merge outputs\\n\",\n",
    "    \"                self.trie[u]['output'].extend(self.trie[self.trie[u]['fail']]['output'])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def get_matrices(self):\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        Returns:\\n\",\n",
    "    \"            transition_table: [num_states * 256] (int64)\\n\",\n",
    "    \"            match_table: [num_states, num_patterns] (float32)\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        num_states = len(self.trie)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Flattened transition table: Index = state * 256 + char_byte\\n\",\n",
    "    \"        # This allows O(1) lookup using 'gather'\\n\",\n",
    "    \"        transition_table = np.zeros(num_states * 256, dtype=np.int64)\\n\",\n",
    "    \"        match_table = np.zeros((num_states, self.num_patterns), dtype=np.float32)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        for s in range(num_states):\\n\",\n",
    "    \"            # Fill match table for this state\\n\",\n",
    "    \"            for pattern_idx in self.trie[s]['output']:\\n\",\n",
    "    \"                match_table[s, pattern_idx] = 1.0\\n\",\n",
    "    \"\\n\",\n",
    "    \"            # Fill transition table (Dense DFA logic)\\n\",\n",
    "    \"            for char_code in range(256):\\n\",\n",
    "    \"                # Determine where we land if we see 'char_code' at state 's'\\n\",\n",
    "    \"                curr = s\\n\",\n",
    "    \"                while True:\\n\",\n",
    "    \"                    if char_code in self.trie[curr]['next']:\\n\",\n",
    "    \"                        next_s = self.trie[curr]['next'][char_code]\\n\",\n",
    "    \"                        break\\n\",\n",
    "    \"                    if curr == 0:\\n\",\n",
    "    \"                        next_s = 0\\n\",\n",
    "    \"                        break\\n\",\n",
    "    \"                    curr = self.trie[curr]['fail']\\n\",\n",
    "    \"                \\n\",\n",
    "    \"                transition_table[s * 256 + char_code] = next_s\\n\",\n",
    "    \"\\n\",\n",
    "    \"        return transition_table, match_table\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 2. The Model\\n\",\n",
    "    \"\\n\",\n",
    "    \"The `VectorizedDFA` module is a PyTorch `nn.Module`. \\n\",\n",
    "    \"\\n\",\n",
    "    \"It does not \\\"train\\\" in the traditional sense. It simply stores the DFA tables as fixed buffers and executes the lookups.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"class VectorizedDFA(nn.Module):\\n\",\n",
    "    \"    def __init__(self, transition_flat, match_matrix):\\n\",\n",
    "    \"        super().__init__()\\n\",\n",
    "    \"        # Register tables as buffers (part of state_dict, but no gradients)\\n\",\n",
    "    \"        self.register_buffer('transitions', torch.from_numpy(transition_flat))\\n\",\n",
    "    \"        self.register_buffer('matches', torch.from_numpy(match_matrix))\\n\",\n",
    "    \"        \\n\",\n",
    "    \"    def forward(self, x):\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        Args:\\n\",\n",
    "    \"            x: Tensor of shape (batch, seq_len) containing byte values (0-255)\\n\",\n",
    "    \"        Returns:\\n\",\n",
    "    \"            found_patterns: (batch, seq_len, num_patterns)\\n\",\n",
    "    \"        \\\"\\\"\\\"\\n\",\n",
    "    \"        batch_size = x.shape[0]\\n\",\n",
    "    \"        seq_len = x.shape[1]\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Start at root state (0)\\n\",\n",
    "    \"        state = torch.zeros(batch_size, dtype=torch.int64, device=x.device)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        results = []\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Process sequence byte-by-byte\\n\",\n",
    "    \"        # This loop is exportable to ONNX as a 'Loop' operator\\n\",\n",
    "    \"        for i in range(seq_len):\\n\",\n",
    "    \"            char = x[:, i]\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            # 1. Calculate table index\\n\",\n",
    "    \"            idx = state * 256 + char\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            # 2. Transition to next state\\n\",\n",
    "    \"            state = self.transitions.gather(0, idx)\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            # 3. Check for matches at current state\\n\",\n",
    "    \"            # index_select maps [batch] states to [batch, num_patterns] matches\\n\",\n",
    "    \"            step_matches = self.matches.index_select(0, state)\\n\",\n",
    "    \"            results.append(step_matches)\\n\",\n",
    "    \"            \\n\",\n",
    "    \"        return torch.stack(results, dim=1)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 3. Usage Example\\n\",\n",
    "    \"\\n\",\n",
    "    \"Let's define some patterns, build the model, and run it on a test string.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Define patterns\\n\",\n",
    "    \"patterns = [\\\"he\\\", \\\"she\\\", \\\"his\\\", \\\"hers\\\"]\\n\",\n",
    "    \"print(f\\\"Building Automaton for: {patterns}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Build tables\\n\",\n",
    "    \"builder = DFABuilder(patterns)\\n\",\n",
    "    \"trans_table, match_table = builder.get_matrices()\\n\",\n",
    "    \"print(f\\\"Compiled DFA: {len(match_table)} states\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Initialize Model\\n\",\n",
    "    \"model = VectorizedDFA(trans_table, match_table)\\n\",\n",
    "    \"model.eval()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Test Input: \\\"ushers\\\"\\n\",\n",
    "    \"text = \\\"ushers\\\"\\n\",\n",
    "    \"input_bytes = torch.tensor([[ord(c) for c in text]], dtype=torch.int64)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Input: '{text}' {input_bytes.tolist()}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"with torch.no_grad():\\n\",\n",
    "    \"    output = model(input_bytes)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Parse Output\\n\",\n",
    "    \"# Output shape: (batch, seq_len, num_patterns)\\n\",\n",
    "    \"found_any = False\\n\",\n",
    "    \"for t in range(output.shape[1]):\\n\",\n",
    "    \"    for p_idx in range(len(patterns)):\\n\",\n",
    "    \"        if output[0, t, p_idx] > 0:\\n\",\n",
    "    \"            print(f\\\"MATCH: Found '{patterns[p_idx]}' ending at index {t}\\\")\\n\",\n",
    "    \"            found_any = True\\n\",\n",
    "    \"\\n\",\n",
    "    \"if not found_any:\\n\",\n",
    "    \"    print(\\\"No matches found.\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 4. Export to ONNX\\n\",\n",
    "    \"\\n\",\n",
    "    \"Finally, we export the model to ONNX so it can be run in non-Python environments (C++, WebAssembly, etc).\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"dummy_input = torch.randint(0, 256, (1, 10), dtype=torch.int64)\\n\",\n",
    "    \"onnx_filename = \\\"vectorized_dfa.onnx\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"torch.onnx.export(\\n\",\n",
    "    \"    model,\\n\",\n",
    "    \"    dummy_input,\\n\",\n",
    "    \"    onnx_filename,\\n\",\n",
    "    \"    input_names=[\\\"input_bytes\\\"],\\n\",\n",
    "    \"    output_names=[\\\"matches\\\"],\\n\",\n",
    "    \"    dynamic_axes={\\n\",\n",
    "    \"        \\\"input_bytes\\\": {0: \\\"batch\\\", 1: \\\"length\\\"},\\n\",\n",
    "    \"        \\\"matches\\\": {0: \\\"batch\\\", 1: \\\"length\\\"}\\n\",\n",
    "    \"    },\\n\",\n",
    "    \"    opset_version=14\\n\",\n",
    "    \")\\n\",\n",
    "    \"print(f\\\"Exported to {onnx_filename}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 5. Verification\\n\",\n",
    "    \"\\n\",\n",
    "    \"We verify the ONNX file produces the exact same output as PyTorch.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"try:\\n\",\n",
    "    \"    import onnxruntime as ort\\n\",\n",
    "    \"    sess = ort.InferenceSession(onnx_filename)\\n\",\n",
    "    \"    onnx_out = sess.run(None, {\\\"input_bytes\\\": input_bytes.numpy()})[0]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    print(\\\"\\\\nONNX Runtime Verification:\\\")\\n\",\n",
    "    \"    print(\\\"Output shape:\\\", onnx_out.shape)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Check for equality\\n\",\n",
    "    \"    diff = np.abs(onnx_out - output.numpy()).sum()\\n\",\n",
    "    \"    if diff == 0:\\n\",\n",
    "    \"        print(\\\"SUCCESS: ONNX output matches PyTorch exactly.\\\")\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        print(f\\\"WARNING: Difference detected: {diff}\\\")\\n\",\n",
    "    \"        \\n\",\n",
    "    \"except ImportError:\\n\",\n",
    "    \"    print(\\\"onnxruntime not installed, skipping verification.\\\")\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
